---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE_TITLE, SITE_SUBTITLE } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  const group = byYear.get(year);
  if (group) {
    group.push(post);
  } else {
    byYear.set(year, [post]);
  }
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const formatDay = (d: Date) =>
  `${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`;
---

<Base>
  <header class="site-header">
    <h1 class="wordmark"><span class="seal" aria-hidden="true"></span>{SITE_TITLE}</h1>
    <p class="subtitle">{SITE_SUBTITLE}</p>
  </header>
  <main>
    {
      years.map((year) => (
        <section class="year-group">
          <h2 class="year">{year}</h2>
          <ul class="post-list">
            {byYear.get(year)!.map((post) => (
              <li>
                <a href={`/posts/${post.id}/`}>
                  <time datetime={post.data.date.toISOString().slice(0, 10)}>
                    {formatDay(post.data.date)}
                  </time>
                  <span class="post-title">{post.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Base>
